#include <bits/stdc++.h>

using namespace std;

#define int long long

void solve() {
    int max_count = 0;
    int max_p = 0;
    for (int p = 1; p <= 1000; ++p) {
        int count = 0;
        for (int a = 1; a < p / 2; ++a) {
            for (int b = a + 1; b < p - a - b; ++b) {
                int c = p - a - b;
                if (a * a + b * b == c * c) {
                    count++;
                }
            }
        }
        if (count > max_count) {
            max_count = count;
            max_p = p;
        }
    }
    cout << max_p << endl;
}

int32_t main() {
    solve();
}
