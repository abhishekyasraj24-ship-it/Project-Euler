#include <bits/stdc++.h>

using namespace std;

#define ll long long

void solve() {
    int p;
    cin >> p;
    vector < int > d;
    d.push_back(1);
    for (int i = 0; i < p; i++) {
        int c = 0;
        for (int j = 0; j < d.size(); j++) {
            int val = d[j] * 2 + c;
            d[j] = val % 10;
            c = val / 10;
        }
        while (c) {
            d.push_back(c % 10);
            c /= 10;
        }
    }
    ll sum = 0;
    for (auto c: d) sum += c;
    cout << sum << '\n';
}

int main() {
    int t;
    cin >> t;
    t=1;
    while (t--) {
        solve();
    }
}
