#include <bits/stdc++.h>

using namespace std;

#define int long long

bool isPrime(int n) {
    if (n <= 1) return false;
    if (n == 2 || n == 3) return true;
    if (n % 2 == 0 || n % 3 == 0) return false;
    for (int i = 5; i * i <= n; i += 6) {
        if (n % i == 0 || n % (i + 2) == 0) return false;
    }
    return true;
}

void solve() {
    int ans = 0;
    for (int i = 1; i < 1e6; i++) {
        bool ok = true;
        if (isPrime(i)) {
            string s = to_string(i);
            string initial_s = s;
            do {
                int num = s[0] - '0';
                for (int j = 1; j < s.size(); j++) {
                    num *= 10;
                    num += (s[j] - '0');
                }
                if (!isPrime(num)) {
                    ok = false;
                    break;
                }
                rotate(s.begin(), s.begin() + 1, s.end());
            } while (s != initial_s);
            if (ok) ans++;
        }
    }
    cout << ans << '\n';
}

int32_t main() {
    solve();
}
