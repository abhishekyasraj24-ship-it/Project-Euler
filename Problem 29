#include <bits/stdc++.h>

using namespace std;

#define int long long

#define ll __int128

void solve() {
    set < vector < pair < int, int >>> d;
    for (int a = 2; a <= 100; a++) {
        for (int b = 2; b <= 100; b++) {
            vector < pair < int, int >> f;
            int t = a;
            for (int i = 2; i * i <= t; i++) {
                if (t % i == 0) {
                    int count = 0;
                    while (t % i == 0) {
                        count++;
                        t /= i;
                    }
                    f.emplace_back(i, count * b);
                }
            }
            if (t > 1) f.emplace_back(t, b);
            d.insert(f);
        }
    }
    cout << (int) d.size() << '\n';
}

int32_t main() {
    solve();
}
