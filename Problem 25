#include <bits/stdc++.h>

using namespace std;

#define int long long

void solve() {
    string a = "1", b = "1";
    int index = 2;
    while (b.size() < 1000) {
        string c = "";
        int carry = 0;
        int i = a.size() - 1, j = b.size() - 1;
        while (i >= 0 || j >= 0 || carry) {
            int sum = carry;
            if (i >= 0) sum += (a[i--] - '0');
            if (j >= 0) sum += (b[j--] - '0');
            c.push_back(char(sum % 10 + '0'));
            carry = sum / 10;
        }
        reverse(c.begin(), c.end());
        a = b;
        b = c;
        index++;
    }
    cout << index << '\n';
}

int32_t main() {
    solve();
}
