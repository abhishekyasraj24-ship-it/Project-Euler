#include <bits/stdc++.h>

using namespace std;

#define int long long

void solve() {
    vector < int > v;
    v.push_back(1);
    for (int i = 2; i <= 100; i++) {
        int carry = 0;
        for (int j = 0; j < v.size(); j++) {
            int val = v[j] * i + carry;
            v[j] = val % 10;
            carry = val / 10;
        }
        while (carry) {
            v.push_back(carry % 10);
            carry /= 10;
        }
    }
    int sum = 0;
    for (auto c: v) sum += c;
    cout << sum << '\n';
}

int32_t main() {
    int t;
    cin >> t;
    t = 1;
    while (t--) {
        solve();
    }
}
