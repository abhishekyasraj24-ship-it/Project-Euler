#include <bits/stdc++.h>

using namespace std;

#define int long long

const int N = 1e10;

int power(int a, int b) {
    if (b == 0) return 1;
    if (b == 1) return a % N;
    else {
        if (b & 1) return (a * ((__int128) power(a, b / 2) * power(a, b / 2) % N)) % N;
        else return (__int128) power(a, b / 2) * power(a, b / 2) % N;
    }
}


