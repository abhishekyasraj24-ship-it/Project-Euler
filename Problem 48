#include <bits/stdc++.h>

using namespace std;

#define int long long

const int N = 1e10;

int power(int a, int b) {
    int r = 1;
    a %= N;
    while (b > 0) {
        if (b & 1) r = (__int128) r * a % N;
        a = (__int128) a * a % N;
        b /= 2;
    }
    return r;
}

void solve() {
    int ans = 0;
    for (int i = 1; i <= 1000; i++) ans = (ans + power(i, i)) % N;
    cout << ans << '\n';
}

int32_t main() {
    solve();
}
